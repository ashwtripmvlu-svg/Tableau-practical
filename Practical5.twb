      <aliases enabled='yes' />
      <column caption='Votes (RUNNING_SUM)' datatype='real' name='[Calculation_1901366480166913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_AVG(SUM([votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Resturant rank' datatype='integer' name='[Calculation_1901366481088514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([votes]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='City Window Average ' datatype='real' name='[Calculation_1901366482894851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(AVG([approx_cost(for two people)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Difference window sum' datatype='real' name='[Calculation_1901366484471812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([votes]) - WINDOW_AVG(SUM([votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dynamic title' datatype='string' name='[Calculation_1901366486130695]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Top&quot; + STR([Parameters].[Parameter 1901366485811206]) + &quot;Resturant by total votes&quot;' />
      </column>
