      <aliases enabled='yes' />
      <column caption='Profit margin ratio' datatype='real' name='[Calculation_0437916488151040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit]/[Sales]' />
      </column>
      <column caption='Total revenu before discount' datatype='real' name='[Calculation_0437916490055681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales]*[Quantity]' />
      </column>
      <column caption='Aggregate profit margin' datatype='real' name='[Calculation_0437916491005954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Fixed Regional Sales' datatype='real' name='[Calculation_0437916491558915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [State]:SUM([Sales])}' />
      </column>
      <column caption='Include sales per customer' datatype='real' name='[Calculation_0437916492251140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE [Customer ID]:SUM([Sales])}' />
      </column>
      <column aggregation='Attribute' caption='Exclude category sales' datatype='real' name='[Calculation_0437916493381637]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [Sub-Category]:SUM([Sales])}' />
      </column>
      <column caption='KPI Thresold Met?' datatype='string' name='[Calculation_0437916494200839]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt;= [Parameters].[Parameter 0437916493717510] THEN &quot;Target Archived&quot;&#13;&#10;ELSE &quot;Below target&quot;&#13;&#10;END' />
      </column>
      <column caption='Cleaned Discount' datatype='real' name='[Calculation_0437916495933448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Discount],0)' />
      </column>
      <column caption='Standardized city type' datatype='string' name='[Calculation_0437916496211977]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([City Type])' />
      </column>
      <column datatype='string' name='[City Type]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
      <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
